# Copy this file to `.env.local` (never committed) and fill in the key, then restart `npm run dev`.
#
# Google Maps Platform browser key for the shop address (ที่ตั้ง). Leave empty to use the sample places.
# In Google Cloud Console, for this key:
#   1. Enable "Places API (New)" (address search) and "Maps Embed API" (the map on the review screen).
#   2. Application restriction: Websites, with the addresses the app runs on (e.g. http://localhost:5173/*).
#   3. API restriction: only the two APIs above.
VITE_GOOGLE_MAPS_API_KEY=
